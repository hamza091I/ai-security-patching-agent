DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=
DJANGO_SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SAMESITE=Lax
MAX_SCAN_BYTES=1000000
SCAN_JOB_TIMEOUT_SECONDS=300
SCAN_JOB_MAX_RETRIES=2
SCAN_JOB_STALE_SECONDS=900
LOG_LEVEL=INFO
GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/github/callback/
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/gitlab/callback/
PROVIDER_HTTP_TIMEOUT_SECONDS=30
REMOTE_SCAN_MAX_FILES=500
REMOTE_SCAN_MAX_FILE_BYTES=1000000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
PUBLIC_BASE_URL=
PROVIDER_PUBLISH_ENABLED=1
PROVIDER_SARIF_UPLOAD=1
PROVIDER_MAX_PUBLISH_ATTEMPTS=3
MERGE_BLOCK_SEVERITIES=CRITICAL,HIGH
